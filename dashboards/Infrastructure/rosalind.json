    {
      "type": "stat",
      "title": "RAID",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-direct"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "max(raidStatus)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Normal",
                  "color": "green"
                },
                "2": {
                  "text": "Repairing",
                  "color": "orange"
                },
                "3": {
                  "text": "Migrating",
                  "color": "orange"
                },
                "4": {
                  "text": "Expanding",
                  "color": "orange"
                },
                "11": {
                  "text": "Degraded",
                  "color": "red"
                },
                "12": {
                  "text": "Crashed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Worst status across the storage pool and volume.",
      "id": 4
    },
    {
      "type": "stat",
      "title": "Volume 1 free",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-direct"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "100 * raidFreeSize{raidName=~\"Volume.*\"} / raidTotalSize",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "id": 5
    },
    {
