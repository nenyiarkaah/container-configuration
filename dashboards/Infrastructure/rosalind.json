    },
    {
      "type": "table",
      "title": "Disks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-direct"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "diskModel",
          "legendFormat": "",
          "refId": "Model",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "diskTemperature",
          "legendFormat": "",
          "refId": "Temp",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "diskStatus",
          "legendFormat": "",
          "refId": "Status",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "diskHealthStatus",
          "legendFormat": "",
          "refId": "Health",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "diskBadSector",
          "legendFormat": "",
          "refId": "Bad",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "diskRemainLife",
          "legendFormat": "",
          "refId": "Life",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Status|Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Normal",
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 2,
                      "to": 99,
                      "result": {
                        "text": "Failed",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 50
                    },
                    {
                      "color": "red",
                      "value": 55
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SSD life left %"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "-"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "RosalindDiskUnhealthy fires if Status or Health leaves Normal; RosalindDiskHot above 55 C for 30 minutes.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "host": true,
              "instance": true,
              "job": true,
              "Value #Model": true
            },
            "indexByName": {
              "diskID": 0,
              "diskModel": 1,
              "Value #Temp": 2,
              "Value #Status": 3,
              "Value #Health": 4,
              "Value #Bad": 5,
              "Value #Life": 6
            },
            "renameByName": {
              "diskID": "Disk",
              "diskModel": "Model",
              "Value #Temp": "Temperature",
              "Value #Status": "Status",
              "Value #Health": "Health",
              "Value #Bad": "Bad sectors",
              "Value #Life": "SSD life left %"
            }
          }
        }
      ],
      "id": 7
    },
