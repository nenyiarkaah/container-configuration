{
  "uid": "homelab-containers",
  "title": "Containers",
  "tags": [
    "homelab",
    "containers",
    "cadvisor"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-direct"
        },
        "query": {
          "query": "label_values(container_last_seen, host)",
          "refId": "host-var"
        },
        "definition": "label_values(container_last_seen, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-direct"
        },
        "query": {
          "query": "label_values(container_last_seen{host=~\"$host\", name!=\"\"}, name)",
          "refId": "container-var"
        },
        "definition": "label_values(container_last_seen{host=~\"$host\", name!=\"\"}, name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Containers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-direct"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "container_last_seen{name!=\"\", host=~\"$host\", name=~\"$container\"}",
          "legendFormat": "",
          "refId": "Seen",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "time() - container_start_time_seconds{name!=\"\", host=~\"$host\", name=~\"$container\"}",
          "legendFormat": "",
          "refId": "Up",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "id": true,
              "instance": true,
              "job": true,
              "Value #Seen": true
            },
            "indexByName": {
              "host": 0,
              "name": 1,
              "container_label_com_docker_compose_project": 2,
              "image": 3,
              "Value #Up": 4
            },
            "renameByName": {
              "host": "Host",
              "name": "Container",
              "container_label_com_docker_compose_project": "Compose project",
              "container_label_com_docker_compose_service": "Service",
              "image": "Image",
              "Value #Up": "Up for"
            }
          }
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-direct"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-direct"
          },
          "expr": "sum by (host, name) (rate(container_cpu_usage_seconds_total{name!=\"\", host=~\"$host\", name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{name}} ({{host}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "CPU cores used.",
      "id": 2
    },
    {
